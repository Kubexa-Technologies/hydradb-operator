{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "hydradb-operator values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          }
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy",
        "pullSecrets"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "required": [
            "cpu",
            "memory"
          ]
        }
      },
      "required": [
        "requests",
        "limits"
      ]
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "installScope": {
      "type": "string",
      "enum": [
        "namespaced",
        "cluster"
      ]
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        }
      },
      "required": [
        "serviceMonitor"
      ]
    },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {
          "type": "boolean"
        }
      },
      "required": [
        "install"
      ]
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "level"
      ]
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "webhook": {
      "type": "object",
      "description": "Ingest webhook receiver (push-triggered GraphIngestSource runs).",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Expose the receiver and its Service."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Receiver port."
        }
      },
      "required": [
        "enabled",
        "port"
      ]
    }
  },
  "required": [
    "image",
    "replicaCount",
    "resources",
    "nodeSelector",
    "tolerations",
    "affinity",
    "installScope",
    "monitoring",
    "crds",
    "log",
    "pdb",
    "networkPolicy"
  ]
}
